diff --git a/src/strategy/triggers/LfgTriggers.cpp b/src/strategy/triggers/LfgTriggers.cpp
index aa170e2b..444626c1 100644
--- a/src/strategy/triggers/LfgTriggers.cpp
+++ b/src/strategy/triggers/LfgTriggers.cpp
@@ -5,6 +5,11 @@
 
 #include "LfgTriggers.h"
 
+#include <mutex>
+#include <unordered_map>
+
+#include "LFGMgr.h"
+#include "MoveSpline.h"
 #include "Playerbots.h"
 
 bool LfgProposalActiveTrigger::IsActive() { return AI_VALUE(uint32, "lfg proposal"); }
