@@ -14,3 +15,40 @@ bool UnknownDungeonTrigger::IsActive()
     return botAI->HasActivePlayerMaster() && botAI->GetMaster() && botAI->GetMaster()->IsInWorld() &&
            botAI->GetMaster()->GetMap()->IsDungeon() && bot->GetMapId() == botAI->GetMaster()->GetMapId();
 }
+
+// NovaCore: zr. LfgTriggers.h
+bool LfgTeleportPendingTrigger::IsActive()
+{
+    Group* group = bot->GetGroup();
+    if (!group || !group->isLFGGroup())
+        return false;
+
+    if (sLFGMgr->GetState(group->GetGUID()) != lfg::LFG_STATE_DUNGEON)
+        return false;
+
+    lfg::LFGDungeonData const* dungeon = sLFGMgr->GetLFGDungeon(sLFGMgr->GetDungeon(group->GetGUID()));
+    if (!dungeon)
+        return false;
+
+    // jau pozemyje, miršta, kovoja, krenta ar teleportuojasi - dabar nieko nedarom (bandys vėliau)
+    if (bot->GetMapId() == dungeon->map || !bot->IsAlive() || bot->IsInCombat() || bot->IsBeingTeleported() || bot->IsFalling())
+        return false;
+
+    // teleportuojamasi tik kai tikras zaidejas jau yra pozemyje (jis paspaude "Eiti i pozemi")
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->GetSource();
+        if (!member || member == bot || !member->IsInWorld() || member->GetMapId() != dungeon->map)
+            continue;
+
+        PlayerbotAI* memberAI = GET_PLAYERBOT_AI(member);
+        if (!memberAI || memberAI->IsRealPlayer())
+        {
+            LOG_INFO("playerbots", "Bot {} <{}>: LFG pakartotinis teleportas i pozemi (zemelapis {})", bot->GetGUID().ToString().c_str(),
+                     bot->GetName().c_str(), dungeon->map);
+            return true;
+        }
+    }
+
+    return false;
+}
