     return botAI->HasActivePlayerMaster() && botAI->GetMaster() && botAI->GetMaster()->IsInWorld() &&
            botAI->GetMaster()->GetMap()->IsDungeon() && bot->GetMapId() == botAI->GetMaster()->GetMapId();
 }
+
+// NovaCore: zr. LfgTriggers.h
+namespace
+{
+    struct PendingTeleport
+    {
+        uint32 since = 0;          // kada pirma karta pastebejom, kad botas LFG grupeje, bet ne pozemyje
+        uint32 attempts = 0;       // iprastu pakartotiniu teleportu skaicius
+        uint32 lastAttempt = 0;
+    };
+
+    std::mutex g_lfgLock;
+    std::unordered_map<ObjectGuid, PendingTeleport> g_pending;
+
+    // Grazina pozemi, jei botas yra LFG grupeje su busena DUNGEON (kitaip nullptr ir busena isvaloma).
+    lfg::LFGDungeonData const* PendingDungeon(Player* bot)
+    {
+        Group* group = bot->GetGroup();
+        if (group && group->isLFGGroup() && sLFGMgr->GetState(group->GetGUID()) == lfg::LFG_STATE_DUNGEON)
+            if (lfg::LFGDungeonData const* dungeon = sLFGMgr->GetLFGDungeon(sLFGMgr->GetDungeon(group->GetGUID())))
+                return dungeon;
+
+        std::lock_guard<std::mutex> guard(g_lfgLock);
+        g_pending.erase(bot->GetGUID());
+        return nullptr;
+    }
+}
+
+void NovaClearStaleFalling(Player* bot, bool stop)
+{
+    if (!bot)
+        return;
+
+    bool const flagFalling = bot->HasUnitMovementFlag(MOVEMENTFLAG_FALLING | MOVEMENTFLAG_FALLING_FAR);
+    bool const splineFalling = bot->movespline && bot->movespline->isFalling();
+    bool const jumping = bot->HasUnitState(UNIT_STATE_JUMPING);
+    if (!flagFalling && !splineFalling && !jumping)
+        return;
+
+    // tikras kritimas (botas daugiau nei 6 yd virs zemes) – nelieciam
+    float const groundZ = bot->GetMapHeight(bot->GetPositionX(), bot->GetPositionY(), bot->GetPositionZ());
+    if (groundZ > INVALID_HEIGHT && bot->GetPositionZ() - groundZ > 6.0f && !bot->IsInWater())
+        return;
+
+    if (flagFalling)
+        bot->RemoveUnitMovementFlag(MOVEMENTFLAG_FALLING | MOVEMENTFLAG_FALLING_FAR);
+    if (jumping)
+        bot->ClearUnitState(UNIT_STATE_JUMPING);
+
+    // judejimo NEstabdom, jei tai tik likusi vėliava (kitaip kas AI tika sustotu kelyje); stabdom tik krintanti spline arba kai prasyta
+    if (stop || splineFalling)
+        bot->StopMoving();
+    else if (flagFalling)
+        bot->SendMovementFlagUpdate();   // klientui – kad nustotu rodyti „krentancio“ animacija
+}
+
+void NovaLfgResetPending(ObjectGuid guid)
+{
+    std::lock_guard<std::mutex> guard(g_lfgLock);
+    g_pending.erase(guid);
+}
+
+bool LfgTeleportPendingTrigger::IsActive()
+{
+    lfg::LFGDungeonData const* dungeon = PendingDungeon(bot);
+    if (!dungeon)
+        return false;
+
+    // jau pozemyje – viskas gerai
+    if (bot->GetMapId() == dungeon->map)
+    {
+        NovaLfgResetPending(bot->GetGUID());
+        return false;
+    }
+
+    // miršta, kovoja, krenta ar teleportuojasi - dabar nieko nedarom (bandys vėliau)
+    if (!bot->IsAlive() || bot->IsInCombat() || bot->IsBeingTeleported())
+        return false;
+
+    uint32 const now = getMSTime();
+    Group* group = bot->GetGroup();
+
+    // ar tikras zaidejas jau yra pozemyje (jis paspaude "Eiti i pozemi")
+    bool humanInside = false;
+    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->GetSource();
+        if (!member || member == bot || !member->IsInWorld() || member->GetMapId() != dungeon->map)
+            continue;
+
+        PlayerbotAI* memberAI = GET_PLAYERBOT_AI(member);
+        if (!memberAI || memberAI->IsRealPlayer())
+        {
+            humanInside = true;
+            break;
+        }
+    }
+
+    std::lock_guard<std::mutex> guard(g_lfgLock);
+    PendingTeleport& p = g_pending[bot->GetGUID()];
+    if (!p.since)
+        p.since = now;
+
+    // jei zaidejas dar nepaspaude – laukiam iki 15 s, tada botai eina patys (kad nebutu „tuscios“ grupes)
+    if (!humanInside && now - p.since < 15000)
+        return false;
+
+    // 3 iprasti bandymai (CMSG_LFG_TELEPORT); po to - priverstinis (LfgForceTeleportTrigger)
+    if (p.attempts >= 3)
+        return false;
+
+    ++p.attempts;
+    p.lastAttempt = now;
+    LOG_INFO("playerbots", "Bot {} <{}>: LFG pakartotinis teleportas i pozemi (zemelapis {}, bandymas {}, zaidejas viduje: {})",
+             bot->GetGUID().ToString().c_str(), bot->GetName().c_str(), dungeon->map, p.attempts, humanInside ? "taip" : "ne");
+    return true;
+}
+
+bool LfgForceTeleportTrigger::IsActive()
+{
+    lfg::LFGDungeonData const* dungeon = PendingDungeon(bot);
+    if (!dungeon || bot->GetMapId() == dungeon->map || !bot->IsAlive() || bot->IsBeingTeleported())
+        return false;
+
+    uint32 const now = getMSTime();
+    std::lock_guard<std::mutex> guard(g_lfgLock);
+    auto it = g_pending.find(bot->GetGUID());
+    if (it == g_pending.end())
+        return false;
+
+    PendingTeleport& p = it->second;
+    if (p.attempts < 3 && now - p.since < 30000)
+        return false;
+    if (p.attempts > 0 && now - p.lastAttempt < 4000)
+        return false;
+
+    LOG_INFO("playerbots", "Bot {} <{}>: LFG iprasti teleportai nepavyko – teleportuojam priverstinai (zemelapis {})",
+             bot->GetGUID().ToString().c_str(), bot->GetName().c_str(), dungeon->map);
+    return true;
+}
