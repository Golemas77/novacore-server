+bool LfgForceTeleportAction::Execute(Event /*event*/)
+{
+    Group* group = bot->GetGroup();
+    if (!group || !group->isLFGGroup())
+        return false;
+
+    lfg::LFGDungeonData const* dungeon = sLFGMgr->GetLFGDungeon(sLFGMgr->GetDungeon(group->GetGUID()));
+    if (!dungeon || bot->GetMapId() == dungeon->map)
+        return false;
+
+    // paruosiam: nutraukiam kova ir burtus, nulipam nuo mount, issiimam is transporto / valdymo
+    if (bot->IsInCombat())
+    {
+        bot->AttackStop();
+        bot->CombatStop(true);
+    }
+    bot->InterruptNonMeleeSpells(true);
+    if (bot->IsMounted())
+        bot->Dismount();
+    if (bot->GetVehicle())
+        bot->ExitVehicle();
+    bot->StopMoving();
+    bot->GetMotionMaster()->Clear();
+    bot->ClearUnitState(UNIT_STATE_ALL_STATE);
+    NovaClearStaleFalling(bot, true);
+
+    if (!bot->GetMap()->IsDungeon() || bot->GetEntryPoint().GetMapId() == MAPID_INVALID)
+        bot->SetEntryPoint();
+
+    bool const ok = bot->TeleportTo(dungeon->map, dungeon->x, dungeon->y, dungeon->z, dungeon->o);
+    LOG_INFO("playerbots", "Bot {} <{}>: priverstinis LFG teleportas i pozemi (zemelapis {}) – {}", bot->GetGUID().ToString().c_str(),
+             bot->GetName().c_str(), dungeon->map, ok ? "pavyko" : "NEPAVYKO");
+
+    // pradedam skaiciuoti is naujo (jei nepavyko – kita karta po ~25 s)
+    NovaLfgResetPending(bot->GetGUID());
+    return ok;
+}
