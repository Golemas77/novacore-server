 #include "MiscPackets.h"
 #include "ObjectMgr.h"
 
+// NovaCore: sprendzia `$g vyr:mot;` (ir `$G ...;`) zymes pagal gavejo lyti. Lietuviskas klientas siu zymu NPC kalbose
+// nesprende (rode "Isveskite $g jį:ją; ..."), todel jas issprendziam patys. Tarpai aplink variantus nukerpami.
+// `$n`, `$r`, `$c` ir kitos zymes paliekamos klientui.
+static std::string ResolveGenderTokens(std::string text, uint8 gender)
+{
+    auto trim = [](std::string const& s)
+    {
+        std::size_t b = s.find_first_not_of(" \t");
+        if (b == std::string::npos)
+            return std::string();
+        std::size_t e = s.find_last_not_of(" \t");
+        return s.substr(b, e - b + 1);
+    };
+
+    std::size_t pos = 0;
+    while ((pos = text.find('$', pos)) != std::string::npos)
+    {
+        if (pos + 1 >= text.size() || (text[pos + 1] != 'g' && text[pos + 1] != 'G'))
+        {
+            ++pos;
+            continue;
+        }
+
+        std::size_t const colon = text.find(':', pos + 2);
+        std::size_t const semicolon = text.find(';', pos + 2);
+        std::size_t const nextDollar = text.find('$', pos + 2);
+        if (colon == std::string::npos || semicolon == std::string::npos || colon > semicolon ||
+            (nextDollar != std::string::npos && nextDollar < semicolon))
+        {
+            ++pos;
+            continue;
+        }
+
+        std::string const male = trim(text.substr(pos + 2, colon - pos - 2));
+        std::string const female = trim(text.substr(colon + 1, semicolon - colon - 1));
+        std::string const& pick = (gender == GENDER_FEMALE) ? female : male;
+        text.replace(pos, semicolon - pos + 1, pick);
+        pos += pick.size();
+    }
+
+    return text;
+}
